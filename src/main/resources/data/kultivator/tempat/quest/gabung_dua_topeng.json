        "gabung pilih:dua_topeng"
      ],
      "akibat_masuk": [
        "gabung.cerita dua_topeng tawaran luar",
        "gabung.pilihan dua_topeng tawaran terima tolak"
      ],
      "cabang": [
        {
          "syarat": [
            "bendera gabung.dua_topeng.terima"
          ],
          "ke": "menyusup"
        }
      ],
      "ke": "tolak",
      "batas_hari": 3,
      "gagal_ke": "tolak"
    },
    {
      "id": "tolak",
      "tujuan": [
        "hari 0"
      ],
      "akibat": [
        "gabung.cerita dua_topeng tolak luar",
        "gabung.sikap luar -5"
      ],
      "ke": "selesai"
    },
    {
      "id": "menyusup",
      "tujuan": [
        "gabung_titik samaran:gerbang"
      ],
      "akibat_masuk": [
        "gabung.samaran mulai",
