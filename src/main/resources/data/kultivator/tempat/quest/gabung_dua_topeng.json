        "gabung pilih:dua_topeng"
      ],
      "akibat_masuk": [
        "gabung.cerita dua_topeng rahasia",
        "gabung.pilihan dua_topeng rahasia bocor berpaling"
      ],
      "cabang": [
        {
          "syarat": [
            "bendera gabung.dua_topeng.berpaling"
          ],
          "ke": "berpaling"
        },
        {
          "syarat": [
            "acak 25"
          ],
          "ke": "ketahuan"
        }
      ],
      "ke": "bocor",
      "batas_hari": 3,
      "gagal_ke": "ketahuan"
    },
    {
      "id": "bocor",
      "tujuan": [
        "hari 0"
      ],
      "akibat": [
        "gabung.samaran bocor",
        "gabung.cerita dua_topeng bocor luar",
