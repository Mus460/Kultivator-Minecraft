      "ke": "selesai"
    },
    {
      "id": "berpaling",
      "tujuan": [
        "hari 0"
      ],
      "akibat": [
        "gabung.cerita dua_topeng berpaling",
        "gabung.samaran berpaling"
      ],
      "ke": "selesai"
    },
    {
      "id": "pulang_kosong",
      "tujuan": [
        "hari 0"
      ],
      "akibat": [
        "gabung.samaran selesai",
        "gabung.cerita dua_topeng pulang_kosong luar",
