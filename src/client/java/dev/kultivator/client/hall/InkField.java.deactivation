package dev.kultivator.client.hall;

import com.mojang.blaze3d.platform.InputConstants;
import dev.kultivator.client.screen.ui.Brush;
import dev.kultivator.client.screen.ui.Palette;
import dev.kultivator.client.screen.ui.UiSound;
import dev.kultivator.client.screen.ui.Widget;
import net.minecraft.client.gui.Font;
import net.minecraft.client.gui.GuiGraphicsExtractor;
import net.minecraft.client.input.CharacterEvent;
import net.minecraft.client.input.KeyEvent;
import net.minecraft.network.chat.Component;
import net.minecraft.util.Util;

import java.util.function.Consumer;

/**
 * A slip of paper to write on (the hall's new name): click to take the brush, type, Enter writes it ({@code onSubmit}),
 * Escape puts the brush down. Only letters, digits, spaces, '-' and '_' are accepted, up to {@code max} characters.
 */
final class InkField extends Widget {

	private final int max;
	private final Consumer<String> onSubmit;
	private String text = "";
	private boolean focused;

	InkField(int x, int y, int w, int h, int max, Consumer<String> onSubmit) {
		super(x, y, w, h);
		this.max = max;
		this.onSubmit = onSubmit;
	}

	boolean focused() {
		return focused;
	}

	void setFocused(boolean focused) {
		this.focused = focused;
	}

	String text() {
		return text;
	}

	void setText(String value) {
		text = value == null ? "" : value.length() > max ? value.substring(0, max) : value;
	}

	@Override
	protected void activate() {
		UiSound.press();
		focused = true;
	}

	boolean keyPressed(KeyEvent event) {
		if (!focused) {
			return false;
		}
		int key = event.key();
		if (key == InputConstants.KEY_ESCAPE) {
			focused = false;
			return true;
		}
		if (key == InputConstants.KEY_RETURN || key == InputConstants.KEY_NUMPADENTER) {
			focused = false;
			onSubmit.accept(text.trim());
			return true;
		}
		if (key == InputConstants.KEY_BACKSPACE) {
			if (!text.isEmpty()) {
				text = text.substring(0, text.length() - 1);
			}
			return true;
		}
		return true;
	}

	boolean charTyped(CharacterEvent event) {
		if (!focused) {
			return false;
		}
		int c = event.codepoint();
		if (text.length() < max && (Character.isLetterOrDigit(c) || c == ' ' || c == '-' || c == '_') && Character.isBmpCodePoint(c)) {
			text = text + (char) c;
		}
		return true;
	}

	@Override
	protected void draw(GuiGraphicsExtractor g, Font font, boolean over, float seconds) {
		dev.kultivator.client.screen.ui.Ketik.fokus(this, focused);
		int edge = focused ? Palette.SEAL : Palette.argb(0xC0, Palette.GOLD);
		g.fill(x, y, x + w, y + h, focused ? 0xFFF6EED2 : Palette.argb(0x60, 0xF6EED2));
		Brush.frame(g, x, y, x + w, y + h, edge);
		String shown = text;
		boolean caret = focused && Util.getMillis() / 400L % 2L == 0L;
		Component line = Component.literal(shown + (caret ? "_" : ""));
		float scale = Math.min(0.85F, (h - 2) / 9.0F);
		Brush.fit(g, font, line, x + 3.0F, y + (h - 8.0F * scale) / 2.0F, w - 6.0F, Palette.INK, scale, 0.5F, false);
	}
}
