package dev.kultivator.client.sekte.gabung.ui;

import dev.kultivator.client.hub.HubCards;
import dev.kultivator.client.hub.HubNav;
import dev.kultivator.client.screen.ui.Glyphs;
import dev.kultivator.client.sekte.gabung.GabungClient;
import dev.kultivator.client.tempat.ui.UiTempatClient;
import dev.kultivator.sekte.gabung.ui.GabungLembar;

/**
 * The two hub cards of 41 (DESIGN 41.10 "Hub"), registered with {@link HubCards#register} (no edit of the hub page):
 * SEKTE "Perguruanku" ({@code gabung_sekteku}, the Kartu Anggota; a player who belongs to no NPC sect gets the Direktori
 * instead, so the card stays open: a locked hub card cannot be clicked) and DUNIA "Direktori Sekte"
 * ({@code gabung_direktori}). The id has no {@code sekte_} prefix, so the card sits in the Aula sub-coin without the hall
 * lock: joining an NPC sect needs no hall. Texts {@code kultivator.hub.card.<id>} / {@code .tip} in
 * {@code lang-src/sekte_gabung_ui.*}.
 */
public final class GabungHub {

	static void init() {
		HubCards.register(HubNav.SEKTE, GabungLembar.HUB_SEKTEKU, Glyphs.SEAL, null, () -> UiTempatClient.lihatDariHub(
				GabungClient.lencanaSendiri() != null ? GabungLembar.Kartu.LAYAR : GabungLembar.Direktori.LAYAR, HubNav.SEKTE));
		HubCards.register(HubNav.DUNIA, GabungLembar.HUB_DIREKTORI, Glyphs.PATH, null,
				() -> UiTempatClient.lihatDariHub(GabungLembar.Direktori.LAYAR, HubNav.DUNIA));
	}

	private GabungHub() {
	}
}
