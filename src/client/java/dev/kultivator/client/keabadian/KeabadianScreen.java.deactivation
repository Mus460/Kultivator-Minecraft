package dev.kultivator.client.keabadian;

import dev.kultivator.client.hub.HubNav;
import net.minecraft.client.gui.screens.Screen;
import net.minecraft.network.chat.Component;

/**
 * Former Keabadian screen (DESIGN 26.10). Since DESIGN 43 (M16) its six tablets are the pages of section Keabadian of the
 * Gulungan Utama (registered by {@code AbadiClient} and {@code TitahClient}); this class only forwards an old opener
 * ({@code DuniaClient.openAbadi}, the transition hub card) to {@code HubNav.buka} on its first tick. P1 renames it to
 * {@code .deactivation} once nothing constructs it (43.15).
 */
public class KeabadianScreen extends Screen {

	private final int tab;

	/** {@code tab}: 0 Alam, 1 Purba, 2 Bencana, 3 Batin, 4 Ciptaan, 5 Lelang ({@code Payloads.OpenScreen.ABADI_*}). */
	public KeabadianScreen(int tab) {
		super(Component.translatable("kultivator.spine9.abadi.title"));
		this.tab = tab;
	}

	/** Old callers switched the open screen's tablet; the Gulungan moves to that page instead. */
	public void showTab(int index) {
		HubNav.buka(HubNav.tujuanAbadi(index));
	}

	@Override
	public void tick() {
		HubNav.buka(HubNav.tujuanAbadi(tab));
	}

	@Override
	public boolean isPauseScreen() {
		return false;
	}
}
