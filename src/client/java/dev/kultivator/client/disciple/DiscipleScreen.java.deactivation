package dev.kultivator.client.disciple;

import dev.kultivator.client.Keys;
import dev.kultivator.client.screen.ui.Glyphs;
import dev.kultivator.network.Payloads;
import net.minecraft.client.gui.screens.Screen;
import net.minecraft.nbt.CompoundTag;
import net.minecraft.network.chat.Component;

import java.util.List;
import java.util.function.Function;

/**
 * Retired (DESIGN 43.12.1): the disciple scroll is now the page Murid › Murid ({@link MuridPage}) of the Gulungan Utama and
 * nothing opens this screen any more. Kept only so the old static entry points still compile while other modules move
 * over; P1 renames this file {@code .deactivation} once no file names it (43.15).
 */
@Deprecated
public class DiscipleScreen extends Screen {

	private final int entityId;

	private DiscipleScreen(int entityId) {
		super(Component.translatable("kultivator.discipleui.title"));
		this.entityId = entityId;
	}

	/**
	 * The next disciple shown within 3 s opens on the sub of the tab with {@code glyph} (the "Jalan Hidup Murid" board):
	 * now {@link MuridPage#subBerikutnya}.
	 */
	public static void bukaTab(int glyph) {
		MuridPage.subBerikutnya(glyph == Glyphs.HATI ? "hati" : glyph == Glyphs.HUBUNGAN ? "hubungan" : glyph == Glyphs.JALAN ? "jalan_hidup" : "");
	}

	/** Retired (R20): the subs of Murid › Murid are listed by {@link MuridPage#subs()}; always false. */
	public static boolean addExtraTab(int glyph, Function<DiscipleScreen, DiscipleTab> factory) {
		return false;
	}

	public int entityId() {
		return entityId;
	}

	DiscipleView view() {
		return new DiscipleView(info());
	}

	public CompoundTag info() {
		CompoundTag info = DiscipleClient.info(entityId);
		return info == null ? new CompoundTag() : info;
	}

	public void send(int action, String text) {
		Keys.send(new Payloads.Action(action, entityId, text));
	}

	public void showTooltip(List<Component> lines) {
	}
}
