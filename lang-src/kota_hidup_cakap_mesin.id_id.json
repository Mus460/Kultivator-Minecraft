  "kultivator.kota42.cakap.cadangan.sapa.0": "Selamat datang, %1$s.",
  "kultivator.kota42.cakap.cadangan.sapa.1": "Oh, %1$s. Apa kabar?",
  "kultivator.kota42.cakap.cadangan.sapa.2": "Salam, %1$s. Semoga hari ini baik untukmu.",
  "kultivator.kota42.cakap.cadangan.sapa.3": "Ah, ada tamu. Silakan, %1$s.",
  "kultivator.kota42.cakap.cadangan.sapa.4": "Hari yang tenang, ya, %1$s?",
  "kultivator.kota42.cakap.cadangan.sapa.5": "%1$s! Lama tak bertegur sapa.",
  "kultivator.kota42.cakap.cadangan.basa_basi.0": "Begitulah, hidup jalan terus.",
  "kultivator.kota42.cakap.cadangan.basa_basi.1": "Hari-hari di sini begitu-begitu saja, %1$s.",
  "kultivator.kota42.cakap.cadangan.basa_basi.2": "Asal perut kenyang dan atap tidak bocor, cukuplah.",
  "kultivator.kota42.cakap.cadangan.basa_basi.3": "Orang bilang %2$s sedang jadi omongan.",
  "kultivator.kota42.cakap.cadangan.basa_basi.4": "Sudah makan, %1$s? Jangan lupa makan.",
  "kultivator.kota42.cakap.cadangan.basa_basi.5": "Angin hari ini lumayan sejuk.",
  "kultivator.kota42.cakap.cadangan.beri_kabar.0": "Kudengar kabar soal %2$s.",
  "kultivator.kota42.cakap.cadangan.beri_kabar.1": "Kau sudah tahu soal %2$s, %1$s?",
  "kultivator.kota42.cakap.cadangan.beri_kabar.2": "Ada cerita tentang %2$s. Orang-orang ramai membicarakannya.",
  "kultivator.kota42.cakap.cadangan.beri_kabar.3": "Soal %2$s, aku tahu sedikit.",
  "kultivator.kota42.cakap.cadangan.tanya.0": "Bagaimana menurutmu soal %2$s, %1$s?",
  "kultivator.kota42.cakap.cadangan.tanya.1": "%1$s dari mana? Jarang kulihat wajahmu.",
  "kultivator.kota42.cakap.cadangan.tanya.2": "Boleh aku bertanya, %1$s?",
  "kultivator.kota42.cakap.cadangan.tanya.3": "Kau tahu sesuatu tentang %2$s?",
  "kultivator.kota42.cakap.cadangan.reaksi.0": "Oh, begitu.",
  "kultivator.kota42.cakap.cadangan.reaksi.1": "Sungguh? Aku tidak menyangka.",
  "kultivator.kota42.cakap.cadangan.reaksi.2": "Hmm... masuk akal juga.",
  "kultivator.kota42.cakap.cadangan.reaksi.3": "Aduh, kasihan sekali.",
  "kultivator.kota42.cakap.cadangan.reaksi.4": "Ha! Bagus itu.",
  "kultivator.kota42.cakap.cadangan.reaksi.5": "Entahlah, %1$s. Aku tak tahu harus bilang apa.",
  "kultivator.kota42.cakap.cadangan.terima_kasih.0": "Terima kasih, %1$s.",
  "kultivator.kota42.cakap.cadangan.terima_kasih.1": "Kau baik sekali, %1$s.",
  "kultivator.kota42.cakap.cadangan.terima_kasih.2": "Budi baikmu tidak akan kulupakan.",
  "kultivator.kota42.cakap.cadangan.terima_kasih.3": "Ah, aku jadi malu. Terima kasih.",
  "kultivator.kota42.cakap.cadangan.tolak.0": "Maaf, %1$s, aku tidak bisa.",
  "kultivator.kota42.cakap.cadangan.tolak.1": "Itu bukan urusanku.",
  "kultivator.kota42.cakap.cadangan.tolak.2": "Lebih baik tidak, %1$s.",
  "kultivator.kota42.cakap.cadangan.tolak.3": "Jangan sekarang. Lain kali saja.",
  "kultivator.kota42.cakap.cadangan.tutup.0": "Sampai jumpa, %1$s.",
  "kultivator.kota42.cakap.cadangan.tutup.1": "Hati-hati di jalan, %1$s.",
  "kultivator.kota42.cakap.cadangan.tutup.2": "Maaf, pekerjaanku menunggu.",
  "kultivator.kota42.cakap.cadangan.tutup.3": "Sudah dulu, ya. Mampirlah lagi.",
  "kultivator.kota42.cakap.cadangan.tutup.4": "Semoga langit melindungimu.",
  "kultivator.kota42.cakap.cadangan.tutup.5": "Aku harus pergi. Lain kali kita sambung.",
  "kultivator.kota42.cakap.cadangan.potong.0": "Tunggu! Ada apa di sana?",
  "kultivator.kota42.cakap.cadangan.potong.1": "Maaf, %1$s, sebentar...",
  "kultivator.kota42.cakap.cadangan.potong.2": "Astaga, dengar itu?",
  "kultivator.kota42.cakap.cadangan.potong.3": "Cepat, cepat, masuk dulu!",
  "kultivator.kota42.cakap.cadangan.kembali.0": "Tadi sampai mana? Oh ya, soal %2$s.",
  "kultivator.kota42.cakap.cadangan.kembali.1": "Maaf, tadi terpotong. Jadi begini...",
  "kultivator.kota42.cakap.cadangan.kembali.2": "Nah, kembali ke %2$s.",
  "kultivator.kota42.cakap.cadangan.kilas_balik.0": "Ingat janjimu, %1$s?",
  "kultivator.kota42.cakap.cadangan.kilas_balik.1": "Lama tidak kelihatan, %1$s.",
  "kultivator.kota42.cakap.cadangan.kilas_balik.2": "Sejak terakhir kita bertemu, banyak yang terjadi.",
  "kultivator.kota42.cakap.cadangan.kilas_balik.3": "Aku masih ingat yang kau lakukan waktu itu.",
  "kultivator.kota42.cakap.cadangan.sambung_rasa.0": "Hmm.",
  "kultivator.kota42.cakap.cadangan.sambung_rasa.1": "Oh ya?",
  "kultivator.kota42.cakap.cadangan.sambung_rasa.2": "Lalu?",
  "kultivator.kota42.cakap.cadangan.sambung_rasa.3": "Iya, iya.",
  "kultivator.kota42.cakap.cadangan.sambung_rasa.4": "Masa?",
  "kultivator.kota42.cakap.cadangan.sambung_rasa.5": "Wah.",
  "kultivator.kota42.cakap.cadangan.koreksi.0": "Bukan begitu. Aku lihat sendiri kejadiannya.",
  "kultivator.kota42.cakap.cadangan.koreksi.1": "Jangan dilebih-lebihkan. Yang benar tidak seheboh itu.",
  "kultivator.kota42.cakap.cadangan.koreksi.2": "Kau salah dengar. Ceritanya lain.",
  "kultivator.kota42.cakap.cadangan.umpan_gosip.0": "Sst, sudah dengar belum?",
  "kultivator.kota42.cakap.cadangan.umpan_gosip.1": "Mau tahu kabar paling baru?",
  "kultivator.kota42.cakap.cadangan.umpan_gosip.2": "Jangan bilang siapa-siapa, ya...",
  "kultivator.kota42.cakap.cadangan.umpan_gosip.3": "Kau pasti belum tahu soal %2$s.",
  "kultivator.kota42.cakap.cadangan.puji.0": "Kau tampak sehat sekali hari ini.",
  "kultivator.kota42.cakap.cadangan.puji.1": "Pekerjaanmu selalu rapi, aku kagum.",
  "kultivator.kota42.cakap.cadangan.puji.2": "Orang sepertimu jarang ada.",
  "kultivator.kota42.cakap.cadangan.hina.0": "Cih. Orang seperti kau tidak tahu diri.",
  "kultivator.kota42.cakap.cadangan.hina.1": "Jaga mulutmu.",
  "kultivator.kota42.cakap.cadangan.hina.2": "Pergi sana sebelum aku kehilangan sabar.",
  "kultivator.kota42.cakap.cadangan.minta.0": "Bisakah kau membantuku, %1$s?",
  "kultivator.kota42.cakap.cadangan.minta.1": "Aku butuh pertolongan kecil.",
  "kultivator.kota42.cakap.cadangan.minta.2": "Kalau tidak merepotkan, %1$s...",
  "kultivator.kota42.cakap.cadangan.tawar.0": "Harga segitu sudah paling murah, %1$s.",
  "kultivator.kota42.cakap.cadangan.tawar.1": "Tambah sedikit lagi, baru kita sepakat.",
  "kultivator.kota42.cakap.cadangan.tawar.2": "Aduh, aku bisa rugi kalau segitu.",
  "kultivator.kota42.cakap.cadangan.janji.0": "Kau janji, ya, %1$s.",
  "kultivator.kota42.cakap.cadangan.janji.1": "Baik, kupegang kata-katamu.",
  "kultivator.kota42.cakap.cadangan.janji.2": "Aku tunggu, jangan lupa.",
  "kultivator.kota42.cakap.cadangan.pamit.0": "Aku pamit dulu.",
  "kultivator.kota42.cakap.cadangan.pamit.1": "Sudah larut, aku pulang.",
  "kultivator.kota42.cakap.cadangan.pamit.2": "Permisi, %1$s.",
  "kultivator.kota42.cakap.cadangan.canda.0": "Kalau aku secepat dirimu, ayamku tak akan pernah lepas!",
  "kultivator.kota42.cakap.cadangan.canda.1": "Hati-hati, nanti kau dikira dewa nyasar.",
  "kultivator.kota42.cakap.cadangan.canda.2": "Ha! Kau ini ada-ada saja.",
  "kultivator.kota42.cakap.cadangan.canda.3": "Jangan buat aku tertawa, pinggangku sakit.",
  "kultivator.kota42.cakap.cadangan.keluh.0": "Aduh, akhir-akhir ini semuanya serba susah.",
  "kultivator.kota42.cakap.cadangan.keluh.1": "Soal %2$s membuatku pusing.",
  "kultivator.kota42.cakap.cadangan.keluh.2": "Tidurku tidak nyenyak memikirkannya.",
  "kultivator.kota42.cakap.cadangan.keluh.3": "Entah sampai kapan begini terus.",
  "kultivator.kota42.cakap.cadangan.hibur.0": "Sudahlah, semua pasti berlalu.",
  "kultivator.kota42.cakap.cadangan.hibur.1": "Kau tidak sendirian. Aku di sini.",
  "kultivator.kota42.cakap.cadangan.hibur.2": "Besok matahari tetap terbit.",
  "kultivator.kota42.cakap.cadangan.hibur.3": "Minum teh dulu, biar tenang.",
  "kultivator.kota42.cakap.cadangan.nasihat.0": "Dengar baik-baik: sabar itu separuh dari ilmu.",
  "kultivator.kota42.cakap.cadangan.nasihat.1": "Pelan-pelan saja, yang penting benar.",
  "kultivator.kota42.cakap.cadangan.nasihat.2": "Kata orang tua dulu, jangan malu bertanya.",
  "kultivator.kota42.cakap.cadangan.tuduh.0": "Pasti kau yang melakukannya!",
  "kultivator.kota42.cakap.cadangan.tuduh.1": "Jangan pura-pura tidak tahu.",
  "kultivator.kota42.cakap.cadangan.tuduh.2": "Semua orang tahu kelakuanmu.",
